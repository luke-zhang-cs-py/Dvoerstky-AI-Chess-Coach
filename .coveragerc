# coverage.py for the repository's own Python: python -m coverage run -m unittest discover -s test -p "test_*.py"
[run]
branch = True
# The C tracer, as on CI's Python 3.12: Python 3.14's sys.monitoring core missed arcs here that ran
# (a one-line `if ...: raise` taken, a one-line def), so the two disagreed.
core = ctrace
# Playwright's sync API runs the code that calls it on greenlets: without this, nothing a script
# does inside `with sync_playwright()` is seen (tools/record_demo.py read as 42%).
concurrency = thread, greenlet
# Every folder that holds the repository's Python, at any depth. Without include_namespace_packages,
# coverage.py lists a file nothing imported only where each folder below these has an __init__.py,
# so an untested script in a new folder would be left out of the total instead of counted at 0%
# (include_namespace_packages, under [report]).
source =
    tools
    experiments
    js
    test
# Tests, not measured: the unittest files here, and the drivers that are tests themselves (each a
# list of checks against the app or an engine). test/coverage_report.py is not one of them: it is measured.
omit =
    test/test_*.py
    test/ui_check.py
    test/dist_check.py
    test/engine_gauntlet.py
    test/stockfish_check.py

[report]
show_missing = True
skip_covered = False
fail_under = 100
include_namespace_packages = True
# The one exclusion: a script's entry point that only calls main(), which the tests call directly.
# exclude_lines, not exclude_also, which keeps coverage.py's own (pragma: no cover, `...` stub
# bodies, if TYPE_CHECKING:); and partial_branches empty, which drops its pragma: no branch.
exclude_lines =
    if __name__ == "__main__":
partial_branches =
